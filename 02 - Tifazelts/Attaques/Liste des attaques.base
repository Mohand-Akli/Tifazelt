filters:
  and:
    - file.inFolder("02 - Tifazelts/Attaques")
views:
  - type: table
    name: Toutes les attaques
    order:
      - file.name
      - Type
      - Catégorie
      - Puissance
      - Précision
      - EM
      - Page
      - Description (visible en jeu)
      - Effet (technique, invisible en jeu)
    sort:
      - property: Type
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Par type
    groupBy:
      property: Type
      direction: ASC
    order:
      - file.name
      - Catégorie
      - Puissance
      - Précision
      - EM
      - Description (visible en jeu)
  - type: table
    name: Par catégorie
    groupBy:
      property: Catégorie
      direction: ASC
    order:
      - file.name
      - Type
      - Puissance
      - Précision
      - EM
